{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/src",
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets/catalog-backup/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "OPTIONS"]
    }
  ]
}
